# Copy to server/.env — never commit .env itself.

# A local mongod, or an Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/adaptive-scheduler

# Any long random string. Signs session JWTs (FR-USR-02).
JWT_SECRET=change-me

PORT=3001

# Dev-facing switch: how an elapsed, incomplete, flexible occurrence is classified at the
# retrieval-time sweep (RescheduleService.sweepElapsed, FR-RSC-01/FR-RSC-10). MISSED (default)
# keeps the documented behavior: the row is marked MISSED and the engine reschedules it.
# COMPLETED marks it complete in place instead, with no reschedule. Optional; unset = MISSED.
# ELAPSED_CLASSIFICATION=MISSED

# How often (minutes) the server sweeps every user's elapsed occurrences in the background,
# rather than only when a schedule is fetched (FR-RSC-10 permits this; it's not required).
# Set to 0 to disable and rely on retrieval-time sweeping only. Optional; unset = 5.
# SWEEP_INTERVAL_MINUTES=5
